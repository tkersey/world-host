{
  "name": "@tkersey/world-host",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.2",
  "description": "Disposable, crash-recoverable reference host for World TurnClosure processes.",
  "files": [
    "agent-runtime-v1/",
    "bin/",
    "capability-packs/",
    "docs/",
    "examples/",
    "scripts/",
    "src/",
    "test/",
    "README.md",
    "WORLD_CARRIER_V0_PLAN.md"
  ],
  "bin": {
    "world-host": "./bin/world-host.mjs",
    "world-host-v1": "./bin/world-host-v1.mjs"
  },
  "scripts": {
    "test": "bun test",
    "proof": "bun test && bun scripts/run-world-conformance.mjs && bun scripts/run-store-conformance.mjs && bun scripts/run-crash-matrix.mjs && bun scripts/run-migration-conformance.mjs && bun scripts/run-security-conformance.mjs",
    "proof:world-real": "bun scripts/run-world-conformance.mjs --world-repo ../world",
    "proof:application-v1": "bun scripts/run-application-v1-conformance.mjs --world-repo ../world",
    "proof:world-real-v1": "bun scripts/run-application-v1-conformance.mjs --world-repo ../world",
    "proof:application-v1-cli": "bun scripts/run-application-v1-cli-conformance.mjs --world-repo ../world",
    "proof:frame-store": "bun test test/application_v1_storage.test.mjs test/application_v1_directory.test.mjs",
    "proof:retry-v1": "bun scripts/run-application-v1-conformance.mjs --world-repo ../world",
    "proof:migration-v1": "bun scripts/run-application-v1-conformance.mjs --world-repo ../world",
    "proof:branching-v1": "bun scripts/run-application-v1-conformance.mjs --world-repo ../world",
    "proof:agent": "bun scripts/run-agent-closure-conformance.mjs",
    "proof:boundaries": "bun scripts/check-boundaries.mjs",
    "proof:capabilities": "bun test test/capability_plane.test.mjs test/capabilities_drivers.test.mjs test/capability_sidecar.test.mjs test/capability_pack_immutability.test.mjs test/secrets.test.mjs",
    "proof:capability-packs": "bun scripts/check-capability-packs.mjs --trusted-execute-adapters",
    "proof:sidecars": "bun test test/capability_sidecar.test.mjs",
    "proof:secrets": "bun test test/capability_plane.test.mjs test/secrets.test.mjs",
    "proof:policy": "bun test test/capability_plane.test.mjs",
    "proof:modes": "bun test test/capability_plane.test.mjs",
    "proof:observability": "bun test test/capability_plane.test.mjs",
    "build:agent-runtime-v1": "bun scripts/build-agent-runtime-v1.mjs",
    "check:agent-runtime-v1": "bun scripts/check-agent-runtime-v1-pack.mjs ./agent-runtime-v1",
    "check:agent-runtime-v1-rc": "bun scripts/check-agent-runtime-v1-pack.mjs ./agent-runtime-v1 --require-release-candidate",
    "conformance:agent-runtime-v1": "bun scripts/run-agent-runtime-v1-conformance.mjs ./agent-runtime-v1",
    "measure:agent-runtime-v1": "bun scripts/measure-agent-runtime-v1.mjs --pack ./agent-runtime-v1 --world-repo ../world",
    "build:agent-runtime": "bun scripts/build-agent-runtime-pack.mjs",
    "check:agent-runtime": "bun scripts/check-agent-runtime-pack.mjs && bun scripts/run-agent-runtime-conformance.mjs && bun scripts/check-agent-runtime-pack.mjs --require-release-receipt && bun scripts/check-agent-runtime-release-receipt.mjs"
  },
  "engines": {
    "bun": ">=1.3.2"
  },
  "dependencies": {},
  "devDependencies": {}
}
